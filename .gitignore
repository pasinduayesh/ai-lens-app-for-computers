# Compiled binaries and build cache
dist/
build/
*.spec

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Local user history & database
screenlens.db
screenshots/
video/

# Scratch & temporary logs
*.log
test_*.png
test_*.py

# Environments
venv/
env/
.env
.gemini/
.idea/
.vscode/
